{
  "name": "orthodox-calendar-layout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "php -S 127.0.0.1:8787 scripts/php-dev-router.php",
    "build": "vue-tsc -b && vite build",
    "assets:decor": "tsx scripts/build-decor-library.ts",
    "assets:png-dpi": "tsx scripts/set-png-dpi.ts",
    "assets:food-markers": "tsx scripts/import-food-marker-sheets.ts",
    "api": "php -S 127.0.0.1:8787 scripts/php-dev-router.php",
    "export:sample": "tsx scripts/generate-sample-pdf.ts",
    "typecheck": "vue-tsc -b",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "test:visual": "tsx scripts/visual-regression.ts",
    "test:visual:update": "tsx scripts/visual-regression.ts --update",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fast-xml-parser": "^5.11.1",
    "pdf-lib": "^1.17.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
