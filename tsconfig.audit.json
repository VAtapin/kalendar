{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "scripts/lib/*.ts",
    "scripts/audit-commemoration-identities.ts",
    "scripts/audit-conditional-calendar.ts",
    "scripts/audit-official-calendar.ts",
    "scripts/audit-independent-xml.ts",
    "scripts/audit-independent-fasting.ts",
    "scripts/audit-official-trapeza.ts",
    "scripts/adjudicate-fasting-differences.ts",
    "scripts/audit-official-reverse.ts",
    "scripts/audit-reading-assignments.ts",
    "scripts/inspect-official-calendar-differences.ts",
    "scripts/inspect-xml-audit-differences.ts",
    "scripts/verify-xml-corrections.ts",
    "scripts/build-xml-corrections-report.ts"
  ]
}
