NODE_ENV=production
CALENDAR_API_HOST=127.0.0.1
CALENDAR_API_PORT=8787
APP_PUBLIC_URL=https://kalender.georg-kloster.ru
CALENDAR_ALLOWED_ORIGIN=https://kalender.georg-kloster.ru
CALENDAR_DATA_DIR=/var/www/vhosts/georg-kloster.ru/kalender.georg-kloster.ru/storage
MAX_SHARED_PROJECT_BYTES=104857600
MAX_PDF_EXPORT_BYTES=314572800

# Единственный подтверждённый e-mail, которому разрешено менять общие макеты
# календарной сетки. Сравнение выполняется только на сервере.
CALENDAR_OWNER_EMAIL=CHANGE_TO_YOUR_EMAIL

# SMTP-параметры почтового ящика монастыря. Пароль хранится только в рабочем .env.
SMTP_HOST=mail.georg-kloster.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@georg-kloster.ru
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=Календарная мастерская <noreply@georg-kloster.ru>
