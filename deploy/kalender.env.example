APP_PUBLIC_URL=https://kalender.georg-kloster.ru
CALENDAR_DATA_DIR=/var/www/vhosts/georg-kloster.ru/kalender.georg-kloster.ru/storage
MAX_SHARED_PROJECT_BYTES=104857600
MAX_PDF_EXPORT_BYTES=314572800

# Единственный подтверждённый e-mail, которому разрешено менять общие макеты.
CALENDAR_OWNER_EMAIL=CHANGE_TO_YOUR_EMAIL

# Почтовый ящик STRATO для отправки ссылок подтверждения.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=webmaster@georg-kloster.ru
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM="Календарная мастерская <webmaster@georg-kloster.ru>"
