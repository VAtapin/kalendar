APP_PUBLIC_URL=https://kalender.georg-kloster.ru
CALENDAR_DATA_DIR=/var/www/vhosts/georg-kloster.ru/kalender.georg-kloster.ru/storage
MAX_SHARED_PROJECT_BYTES=104857600
MAX_PDF_EXPORT_BYTES=314572800

# Отдельный вход администратора. Задайте через php scripts/setup-admin.php.
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=

# SMTP почтового ящика Plesk. При обновлении сохраняйте свой рабочий .env.
MAIL_TRANSPORT=smtp
SMTP_HOST=georg-kloster.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kalender@georg-kloster.ru
SMTP_PASSWORD=CHANGE_ME
# Альтернатива: MAIL_TRANSPORT=sendmail для локальной почтовой службы PHP/Plesk.
MAIL_FROM_ADDRESS=kalender@georg-kloster.ru
MAIL_FROM_NAME=Календарная мастерская
