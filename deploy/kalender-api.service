[Unit]
Description=Kalender Georg Kloster API
After=network.target

[Service]
Type=simple
# Замените GEORG_SYSTEM_USER на системного пользователя подписки Plesk.
User=GEORG_SYSTEM_USER
Group=psacln
WorkingDirectory=/var/www/vhosts/georg-kloster.ru/kalender.georg-kloster.ru
EnvironmentFile=/var/www/vhosts/georg-kloster.ru/kalender.georg-kloster.ru/.env
ExecStart=/usr/bin/node /var/www/vhosts/georg-kloster.ru/kalender.georg-kloster.ru/server-dist/calendar-api-server.mjs
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/vhosts/georg-kloster.ru/kalender.georg-kloster.ru/storage

[Install]
WantedBy=multi-user.target
