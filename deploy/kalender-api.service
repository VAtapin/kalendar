[Unit]
Description=Kalender Georg Kloster API
After=network.target

[Service]
Type=simple
# Замените GEORG_SYSTEM_USER на системного пользователя подписки Plesk.
User=GEORG_SYSTEM_USER
Group=psacln
WorkingDirectory=/var/www/vhosts/georg-kloster.ru/kalender.georg-kloster.ru
EnvironmentFile=/var/www/vhosts/georg-kloster.ru/kalender.georg-kloster.ru/.env
ExecStart=/usr/bin/npm run api
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
