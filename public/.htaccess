DirectoryIndex index.html

<IfModule mod_headers.c>
    # A new navigation must revalidate the entry point, including SPA routes.
    <Files "index.html">
        Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Clean public document URLs, before the Vue application fallback.
    RewriteRule ^(icons|icons-of-mother-of-god|web-calendar|wordpress-plugin|calendar-api-test|calendar-icons-test)/?$ $1.html [L]

    # PHP handles only the server functions requested by the editor.
    RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

    # Missing static resources are real 404s, never an HTML success response.
    # This must precede the SPA fallback (which is only for application routes).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(?:assets|fonts|brand|data|downloads)(?:/|$) - [R=404,L]

    # Keep real files and directories intact; everything else opens the app.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
